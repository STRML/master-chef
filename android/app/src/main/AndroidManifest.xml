<?xml version="1.0" encoding="utf-8"?>
<!-- Quest 3 (Android arm64) manifest for the Halo PC port.
     The app is a NativeActivity hosting libhaloquest.so, which runs the
     translated engine behind the Vulkan renderer and the OpenXR shell
     (native/EngineHost/android). The OpenXR loader is dlopened from the
     QVR runtime at startup; nothing here, and nothing in the APK, contains
     original game data.
     Game payload is pushed to app-specific external storage at runtime
     (see the Quest setup stage), so no storage permissions are declared. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    android:versionCode="1"
    android:versionName="0.1.0">

    <!-- Vulkan is the mandatory graphics backend (port plan, issue #1). -->
    <uses-feature android:name="android.hardware.vulkan"
        android:version="0x000a0000"
        android:required="true" />
    <!-- Native stereo with head tracking; no passthrough, no hand tracking. -->
    <uses-feature android:name="android.hardware.vr.headtracking"
        android:version="1"
        android:required="true" />
    <uses-feature android:name="org.khronos.openxr" android:required="true" />
    <!-- Android 11+ package visibility: without these <queries>, the OpenXR
         loader sees neither runtime broker ("Could access neither the
         installable nor system runtime broker") and xrCreateInstance returns
         XR_ERROR_INITIALIZATION_FAILED. -->
    <queries>
        <intent>
            <action android:name="org.khronos.openxr.runtime_broker" />
        </intent>
        <intent>
            <action android:name="org.khronos.openxr.system_runtime_broker" />
        </intent>
    </queries>

    <!-- Controller input: gamepad plus haptics (docs/CONTROLS.md mapping). -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <application
        android:label="Halo Quest"
        android:appCategory="game"
        android:hasCode="true"
        android:allowBackup="false"
        android:extractNativeLibs="true">
        <activity
            android:name="com.oculus.nativeglue.OculusNativeActivity"
            android:label="Halo Quest"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="landscape"
            android:configChanges="orientation|screenSize|keyboardHidden|keyboard|navigation|density">
            <meta-data
                android:name="android.app.lib_name"
                android:value="haloquest" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <!-- Meta's launch check only arms VR activities that request
                     this category; the loader then serves the instance. -->
                <category android:name="com.oculus.intent.category.VR" />
                <category android:name="org.khronos.openxr.intent.category.IMMERSIVE" />
            </intent-filter>
        </activity>
        <!-- The Meta OpenXR loader derives available form factors from this
             application metadata (OpenXR Mobile SDK template). -->
        <meta-data
            android:name="com.oculus.supportedDevices"
            android:value="quest2|quest3|questpro" />
    </application>
</manifest>
