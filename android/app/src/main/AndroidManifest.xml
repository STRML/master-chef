<?xml version="1.0" encoding="utf-8"?>
<!-- Quest 3 (Android arm64) manifest for the Halo PC port.
     The app is a NativeActivity hosting libhaloquest.so, which runs the
     translated engine behind the Vulkan renderer and the OpenXR shell
     (native/EngineHost/android). The OpenXR loader is dlopened from the
     QVR runtime at startup; nothing here, and nothing in the APK, contains
     original game data.
     Game payload is pushed to app-specific external storage at runtime
     (see the Quest setup stage), so no storage permissions are declared. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    android:versionCode="1"
    android:versionName="0.1.0">

    <!-- Vulkan is the mandatory graphics backend (port plan, issue #1). -->
    <uses-feature android:name="android.hardware.vulkan"
        android:version="0x000a0000"
        android:required="true" />
    <!-- Native stereo with head tracking; no passthrough, no hand tracking. -->
    <uses-feature android:name="android.hardware.vr.headtracking"
        android:version="1"
        android:required="true" />
    <uses-feature android:name="org.khronos.openxr" android:required="true" />

    <!-- Controller input: gamepad plus haptics (docs/CONTROLS.md mapping). -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:label="Halo Quest"
        android:appCategory="game"
        android:hasCode="false"
        android:allowBackup="false"
        android:extractNativeLibs="true">
        <activity
            android:name="android.app.NativeActivity"
            android:label="Halo Quest"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="landscape"
            android:configChanges="orientation|screenSize|keyboardHidden|keyboard|navigation|density">
            <meta-data
                android:name="android.app.lib_name"
                android:value="haloquest" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <!-- Meta's OpenXR loader refuses xrCreateInstance
                     (XR_ERROR_FORM_FACTOR_UNAVAILABLE) for processes that were
                     not armed as VR activities by the launcher. -->
                <category android:name="com.oculus.intent.category.VR" />
                <category android:name="org.khronos.openxr.intent.category.IMMERSIVE" />
            </intent-filter>
        </activity>
        <!-- Meta's OpenXR loader derives the available form factors from this
             application metadata (OpenXR Mobile SDK template). Without it,
             xrGetSystem(XR_FORM_FACTOR_HEAD_MOUNTED_DISPLAY) fails with
             XR_ERROR_FORM_FACTOR_UNAVAILABLE (-6) on Quest. -->
        <meta-data
            android:name="com.oculus.supportedDevices"
            android:value="quest2|quest3|questpro" />
    </application>
</manifest>
